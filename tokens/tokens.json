{
  "$meta": {
    "name": "Neurora design tokens — ink/acid v1",
    "source": "Paperclip NEU-57 / document design-system-tokens",
    "sourceRevision": 2,
    "sourceRevisionId": "6ea8016a-2312-4419-9541-27032cd73c8b",
    "exported": "2026-10-27",
    "units": "pt == dp == sp for this system; all hex is sRGB",
    "normative": "Where a spec and these tokens disagree, the tokens doc wins or gets commented — one source of truth per value."
  },
  "color": {
    "acid":          { "hex": "#E6FF00", "swiftui": "NeuroraTheme.Color.acid",   "compose": "NeuroraTheme.colors.acid",   "usage": "Live capture affordance only (orb, mic zone fill, focus ring). One acid element per surface. Never on a non-capture surface." },
    "on-acid":       { "hex": "#0D0D0D", "swiftui": "NeuroraTheme.Color.onAcid", "compose": "NeuroraTheme.colors.onAcid", "usage": "Glyphs/labels on acid" },
    "ink":           { "hex": "#0B0B0B", "swiftui": "NeuroraTheme.Color.ink",    "compose": "NeuroraTheme.colors.ink",    "usage": "Partner panel canvas, show-card, ink fills, primary buttons. Intentionally not pure black (OLED smear)." },
    "paper":         { "hex": "#FFFFFF", "swiftui": "NeuroraTheme.Color.paper",  "compose": "NeuroraTheme.colors.paper",  "usage": "Cards, sheets, fields" },
    "paper-canvas":  { "hex": "#F4F4F4", "swiftui": "NeuroraTheme.Color.paperCanvas", "compose": "NeuroraTheme.colors.paperCanvas", "usage": "Screen backdrop behind cards/sheets" },
    "ink-text":      { "hex": "#0D0D0D", "swiftui": "NeuroraTheme.Color.inkText", "compose": "NeuroraTheme.colors.inkText", "usage": "Body/display text on paper" },
    "mono-gray":     { "hex": "#5D5D5D", "swiftui": "NeuroraTheme.Color.monoGray", "compose": "NeuroraTheme.colors.monoGray", "usage": "Meta voice on ink / quiet copy. Contrast floor >=4.5:1 on painted surface." },
    "mono-gray-ink": { "hex": null, "value": "rgba(255,255,255,0.55)", "swiftui": "NeuroraTheme.Color.monoGrayInk", "compose": "NeuroraTheme.colors.monoGrayInk", "usage": "Disabled/quiet meta on ink surfaces" },
    "hairline-paper":{ "hex": "#E3E3E3", "swiftui": "NeuroraTheme.Color.hairlinePaper", "compose": "NeuroraTheme.colors.hairlinePaper", "usage": "Row/card dividers on paper" },
    "hairline-ink":  { "hex": null, "value": "rgba(255,255,255,0.14)", "swiftui": "NeuroraTheme.Color.hairlineInk", "compose": "NeuroraTheme.colors.hairlineInk", "usage": "Dividers/grabber on ink" },
    "outline":       { "hex": "#A6A6A6", "swiftui": "NeuroraTheme.Color.outline", "compose": "NeuroraTheme.colors.outline", "usage": "1pt outlines: pills, GET buttons, outlined actions" },
    "acid-dim":      { "hex": "#92A202", "swiftui": "NeuroraTheme.Color.acidDim", "compose": "NeuroraTheme.colors.acidDim", "usage": "Progress hairline riding on the acid block" }
  },
  "colorRules": [
    "acid marks live capture only; one acid element per surface; zero acid on non-capture surfaces (packs) is a per-element assertion, not a style preference",
    "no error color anywhere — failures render in mono-gray with honest copy",
    "acid is NOT a Material role — Compose primary maps to ink; acid lives outside Material slots"
  ],
  "type": {
    "display":          { "face": "rounded-gothic-heavy", "sizePt": 34, "floorPt": 28, "maxLines": 3, "scale": "shrink-to-fit, never ellipsis-truncate", "swiftui": ".neuroraDisplay",  "compose": "NeuroraType.display",        "usage": "Partner-facing display. Floor 28pt is hard; Dynamic Type does not push lower." },
    "display-list":     { "face": "rounded-gothic-heavy", "sizePt": 17, "lines": 1, "truncation": "yes", "swiftui": ".neuroraDisplayList", "compose": ".displayList",   "usage": "Recents partner line" },
    "display-card":     { "face": "rounded-gothic-heavy", "sizePt": 20, "swiftui": ".neuroraDisplayCard", "compose": ".displayCard", "usage": "Partner text on turn cards" },
    "display-showcard": { "face": "rounded-gothic-heavy", "sizePt": 44, "swiftui": ".neuroraShowcard", "compose": ".showcard", "usage": "Shared show-card component" },
    "body":             { "face": "neo-grotesk-regular", "sizePt": 17, "lineHeight": 1.35, "swiftui": ".neuroraBody", "compose": ".body", "usage": "Traveler prose, native language names" },
    "body-list":        { "face": "neo-grotesk-regular", "sizePt": 15, "swiftui": ".neuroraBodyList", "compose": ".bodyList", "usage": "Recents traveler original, card copy" },
    "mono":             { "face": "mono", "sizePt": 11, "case": "uppercase at string layer (not font features)", "tracking": "+8.5% (SwiftUI .tracking(0.935); Compose letterSpacing 0.085.em)", "swiftui": ".neuroraMono", "compose": ".mono", "usage": "The status voice — all meta strings, every number/status (sizes, percents, ETAs, timestamps)" },
    "mono-small":       { "face": "mono", "sizePt": 10.5, "case": "uppercase", "tracking": "+8.5%", "swiftui": ".neuroraMonoSmall", "compose": ".monoSmall", "usage": "Timestamps, captions, filter chips" },
    "mono-chip":        { "face": "mono", "sizePt": 9.5, "case": "uppercase", "tracking": "+8.5%", "swiftui": ".neuroraMonoChip", "compose": ".monoChip", "usage": "KEEP chip only" }
  },
  "typeRules": [
    "mono owns every number/status string — never proportional digits there",
    "mono-caps strings carry a 1.45x localization width allowance; clip centered, never wrap",
    "tracking stays +8.5% at every mono size"
  ],
  "metric": {
    "header-height":   { "value": 44,   "swiftui": "NeuroraTheme.Metric.headerHeight", "compose": "NeuroraMetrics.HeaderHeight", "note": "Identical on all surfaces, never moves; packs sheet pins at y=44" },
    "screen-margin":   { "value": 20,   "swiftui": ".screenMargin",   "compose": "ScreenMargin" },
    "sheet-corner":    { "value": 24,   "swiftui": ".sheetCorner",    "compose": "SheetCorner", "note": "Traveler sheet, pack sheet, pack confirm card" },
    "grabber-width":   { "value": 36 }, "grabber-height": { "value": 4 }, "grabber-top-offset": { "value": 12 }, "grabber-hit-zone": { "value": 28 },
    "hit-min":         { "value": 44,   "swiftui": ".hitMin",         "compose": "HitMin" },
    "hit-capture":     { "value": 48,   "swiftui": ".hitCapture",     "compose": "HitCapture", "note": "Mic bar zones, orb" },
    "orb-size":        { "value": 56,   "swiftui": ".orbSize",        "compose": "OrbSize" },
    "mic-bar-height":  { "value": 64,   "swiftui": ".micBarHeight",   "compose": "MicBarHeight", "note": "Straddles the split seam" },
    "dock-height":     { "value": 84,   "swiftui": ".dockHeight",     "compose": "DockHeight", "note": "Bottom-anchored, no visible bar" },
    "divider-hit":     { "value": 28,   "swiftui": ".dividerHit",     "compose": "DividerHit" },
    "divider-snaps":   { "value": [30, 54, 78], "unit": "percent", "swiftui": ".dividerSnaps", "compose": "DividerSnaps" },
    "partner-share":   { "value": 46,   "unit": "percent of region below header", "swiftui": ".partnerShare", "compose": "PartnerShare" },
    "pack-row-height": { "value": 72,   "swiftui": ".packRowHeight",  "compose": "PackRowHeight", "note": "Hairline top" },
    "cell-min":        { "value": 64 }, "cell-max": { "value": 96 },
    "pill-status":     { "value": 24 }, "pill-filter": { "value": 32 }, "pill-facetoface": { "value": 44 },
    "progress-height": { "value": 2,    "swiftui": ".progressHeight", "compose": "ProgressHeight", "note": "Ink fill on hairline track" }
  },
  "motion": {
    "shimmer-ms":  { "min": 200, "max": 300, "note": "ADR-0001 ceiling — the only transition theater" },
    "sheet-spring-ms": { "max": 250 },
    "crossfade-ms": { "value": 200, "note": "Surface change (home <-> face-to-face)" }
  }
}
